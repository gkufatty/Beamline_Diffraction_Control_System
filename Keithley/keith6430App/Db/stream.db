
record(lsi, "$(P):$(R):idn") {
    field(DESC, "identification")
    field(DTYP, "stream")
    field(INP, "@cool.proto getIDN $(PORT)")
    field(SCAN, "Passive")
}

record(ai, "$(P):$(R):meas-curr") {
    field(DESC, "measured current")
    field(DTYP, "stream")
    field(INP, "@cool.proto measCurr $(PORT)")
    field(EGU, "A")
    field(SCAN, "2 second")
}

record(bo, "$(P):$(R):form-elem-curr") {
    field(DESC, "config format: read current only")
    field(DTYP, "stream")
    field(OUT, "@cool.proto setFormElemCurr $(PORT)")
    field(ZNAM, "0")
    field(ONAM, "1")
    field(PINI, "YES")
}

record(ao, "$(P):$(R):curr-range") {
    field(DESC, "current range setpoint")
    field(DTYP, "stream")
    field(OUT, "@cool.proto setCurrRange $(PORT)")
    field(EGU, "A")
    field(PREC, "6")
}

record(ai, "$(P):$(R):curr-range-rbv") {
    field(DESC, "current range readback")
    field(DTYP, "stream")
    field(INP, "@cool.proto getCurrRange $(PORT)")
    field(EGU, "A")
    field(PREC, "6")
    field(SCAN, "Passive")
}

record(lsi, "$(P):$(R):err") {
    field(DESC, "communication status")
    field(DTYP, "stream")
    field(INP, "@cool.proto getErr $(PORT)")
    field(SCAN, "Passive")
}

record(mbbo, "$(P):$(R):auto-zero") {
    field(DESC, "auto zero control")
    field(DTYP, "stream")
    field(OUT, "@cool.proto setAutoZero $(PORT)")
    field(ZRST, "Off")
    field(ZRVL, "0")
    field(ONST, "On")
    field(ONVL, "1")
    field(TWST, "Once")
    field(TWVL, "2")
}

record(mbbi, "$(P):$(R):auto-zero-rbv") {
    field(DESC, "auto zero readback")
    field(DTYP, "stream")
    field(INP, "@cool.proto getAutoZero $(PORT)")
    field(ZRST, "Off")
    field(ZRVL, "0")
    field(ONST, "On")
    field(ONVL, "1")
    field(SCAN, "Passive")
}

record(bo, "$(P):$(R):curr-range-auto") {
    field(DESC, "autorange enable")
    field(DTYP, "stream")
    field(OUT, "@cool.proto setRangeAuto $(PORT)")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

record(bi, "$(P):$(R):curr-range-auto-rbv") {
    field(DESC, "autorange readback")
    field(DTYP, "stream")
    field(INP, "@cool.proto getRangeAuto $(PORT)")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SCAN, "Passive")
}

record(ao, "$(P):$(R):nplc") {
    field(DESC, "integration time setpoint")
    field(DTYP, "stream")
    field(OUT, "@cool.proto setNPLC $(PORT)")
    field(PREC, "2")
    field(DRVL, "0.01")
    field(DRVH, "10")
}

record(ai, "$(P):$(R):nplc-rbv") {
    field(DESC, "integration time readback")
    field(DTYP, "stream")
    field(INP, "@cool.proto getNPLC $(PORT)")
    field(PREC, "2")
    field(SCAN, "Passive")
}

record(bo, "$(P):$(R):err-clr") {
    field(DESC, "clear error queue")
    field(DTYP, "stream")
    field(OUT, "@cool.proto clearErrQueue $(PORT)")
    field(ZNAM, "Done")
    field(ONAM, "Clear")
}
